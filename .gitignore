# ===================================
# CHIMERA - GLOBAL GITIGNORE
# ===================================

# --- 1. GİZLİ VE ÖZEL DOSYALAR (Asla Git'e gitmez) ---
.env

# --- 2. GO (Patron) ---
# Derlenmiş binary dosyaları
/bin/
/dist/
agentServer.exe
# Test çıktıları
*.test
*.out

# --- 3. PYTHON (Motor Dairesi) ---
# Sanal ortam klasörleri (Nerede olursa olsun yoksay)
.venv/
# Bytecode (Derlenmiş python dosyaları)
__pycache__/
*.py[cod]

# --- 4. NODE.JS (Motor Dairesi) ---
# Modül klasörleri (Nerede olursa olsun yoksay)
node_modules/

# --- 5. DATA VE LOGLAR (Hafıza) ---
# Veritabanı dosyaları (Local DB)
data/db/*.db
data/db/*.sqlite
# Log dosyaları
data/logs/*
# İndirilen dosyalar
data/downloads/*

# --- 6. EDITOR VE IDE AYARLARI ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- 7. ÖZEL DURUM: Runtimes İçi ---
# Runtimes içindeki klasör yapısını koru ama içindeki şişkinliği at.
# (Yukarıdaki 'venv/' ve 'node_modules/' kuralları burayı zaten koruyor)

# --- 8. ARCH LINUX / SYSTEM ---
*.pkg.tar.zst
core
!internal/**/core

# --- 9. third_party / HARICI KABUL ÖNERİSİ ---

**/third_party/*
!/**/third_party/readme.md